# Copiar a .env para desarrollo local. NUNCA commitear .env real (ver .gitignore).
# En entornos desplegados, estas variables se inyectan vía el gestor de secretos
# de la plataforma (no vía archivo) — ver docs/19-adr o el ADR de gestión de secretos.

NODE_ENV=development
PORT=3000

# Base de datos
DATABASE_URL=postgres://medical_pathway:medical_pathway_dev@localhost:5432/medical_pathway
DATABASE_SSL=false

# Autenticación
JWT_ACCESS_SECRET=change-me-in-local-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Radar de Espera
RADAR_K_ANONIMATO_UMBRAL=5

# Observabilidad
LOG_LEVEL=info

# CORS (ver ADR-024) — orígenes permitidos, coma-separado. Sin definir, solo
# permite http://localhost:3000 (frontend y API en el mismo proceso local).
# En Render (beta cerrada): la URL del proyecto de Vercel de la beta.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Vercel) — NO es una variable del backend. Se usa solo como Build
# Command de Vercel (scripts/generate-frontend-config.js) para generar
# public/config.js con la URL absoluta de la API en Render. Sin definir,
# el frontend usa el fallback relativo /api/v1 (desarrollo local).
API_BASE_URL=

# Panel privado de "Comparte tu historia" (ver AdminBasicAuthGuard). Sin
# definir AMBAS variables, el panel queda inaccesible (fail-closed).
ADMIN_PANEL_USER=
ADMIN_PANEL_PASSWORD=

# Academia Privada — MVP de un curso ("Elaboración de Reporte de Caso").
# ACADEMIA_TOKEN_SECRET firma las URLs de reproducción (propias, sin
# proveedor externo) — genera uno nuevo con `openssl rand -hex 32`, nunca
# reuses JWT_ACCESS_SECRET. ACADEMIA_ARCHIVOS_DIR es la carpeta (fuera de
# public/, nunca servida públicamente) donde viven los 3 videos + el PDF;
# en Render debe apuntar a un disco persistente para sobrevivir redeploys.
ACADEMIA_TOKEN_SECRET=
ACADEMIA_ARCHIVOS_DIR=./academia-privada-archivos
